# OS and editor artifacts
.DS_Store
.vscode/
.idea/

# Python environments and caches (recreate rather than back up)
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# Never publish credentials
.env
.env.*
!.env.example
*.pem
*.key

# EDGAR Online workbooks have unclear redistribution rights.
# Keep exact originals in the private archive pending rights review.
/data/raw/financials/*.xls
/data/raw/financials/*.xlsx

# Nonessential transient files
*.log
*.tmp
*.temp

# IMPORTANT: Project source data, interim/processed data and outputs ARE NOT
# ignored. All reproducibility-relevant artifacts should be committed.
# Large files in those directories are tracked through Git LFS (.gitattributes).
