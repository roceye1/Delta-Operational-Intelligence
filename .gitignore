# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/

# Environment / credentials
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# Logs / temp files
*.log
*.tmp
*.temp

# Raw source data stays local only.
# The source register documents where each raw dataset came from.
/data/raw/

# Temporary and generated datasets stay local unless deliberately published.
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated model artifacts
outputs/model/*
!outputs/model/.gitkeep

# Keep SQL results/predictions out until intentionally selected for portfolio publishing
outputs/sql_results/*
!outputs/sql_results/.gitkeep
outputs/predictions/*
!outputs/predictions/.gitkeep
